DROP DATABASE IF EXISTS fts_hotpath_regression;
CREATE DATABASE fts_hotpath_regression;
USE fts_hotpath_regression;
SELECT JSON_CONTAINS(TOKENIZE('hello world', 'ik'),
                     JSON_ARRAY('hello', 'world')) AS ik_tokens_ok;
ik_tokens_ok
1
SELECT JSON_CONTAINS(TOKENIZE('Hello WORLD', 'beng'),
                     JSON_ARRAY('hello', 'world')) AS beng_tokens_ok;
beng_tokens_ok
1
SELECT JSON_EXTRACT(
  TOKENIZE(REPEAT('alpha beta gamma ', 70), 'beng', '[{"output":"all"}]'),
  '$.doc_len') AS beng_long_doc_tokens;
beng_long_doc_tokens
210
CREATE TABLE docs (
  id INT PRIMARY KEY,
  ik_text TEXT,
  beng_text TEXT
);
INSERT INTO docs VALUES
  (1, 'OceanBase database search', 'OceanBase database search'),
  (2, 'Hello world', 'Hello world');
ALTER TABLE docs ADD FULLTEXT INDEX fts_ik(ik_text) WITH PARSER ik;
ALTER TABLE docs ADD FULLTEXT INDEX fts_beng(beng_text) WITH PARSER beng;
SELECT COUNT(*) AS ik_match_count FROM docs WHERE MATCH(ik_text) AGAINST('oceanbase');
ik_match_count
1
SELECT COUNT(*) AS beng_match_count FROM docs WHERE MATCH(beng_text) AGAINST('oceanbase');
beng_match_count
1
DROP DATABASE fts_hotpath_regression;
